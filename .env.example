# ==============================================================================
# Automated Content Transformation Platform - Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Default PostgreSQL URL (for Docker / local postgres service):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/content_transformer
# SQLite fallback for offline / single-machine local test without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./content_transformer.db

# Groq API Configuration (Instruction-tuned LLM approach)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face & Local Model Configuration (Transformer Seq2Seq approach)
HF_TOKEN=your_hf_token_here
HF_HOME=./models_cache
FLAN_T5_MODEL=google/flan-t5-base
BART_MODEL=facebook/bart-base
DEVICE=auto

# Storage Configuration
UPLOAD_DIR=./storage/uploads
EXPORT_DIR=./storage/exports
MAX_UPLOAD_SIZE_MB=25

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
